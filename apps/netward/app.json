{
  "spec_version": "1.0",
  "metadata": {
    "id": "netward",
    "name": "Netward",
    "description": "Netward finds every device on your home network and gives it a readable name and icon. It shows who is online, alerts you when an unknown device appears or the internet goes down, and checks the network for common weak spots such as open Telnet or RDP, devices without security updates, a rogue DHCP server and ARP spoofing. Notifications via ntfy, Gotify, Pushover, Telegram, Discord, Slack, webhook and e-mail; Home Assistant via MQTT; optional FRITZ!Box integration. No cloud, no subscription, no telemetry.",
    "tagline": "See every device on your home network",
    "version": "0.4.1",
    "author": "Pyzyi",
    "developer": "Pyzyi",
    "category": "Network",
    "license": "MIT",
    "homepage": "https://github.com/Pyzyi/Netward",
    "source": "big-bear-universal",
    "created": "2026-10-28T00:00:00Z",
    "updated": "2026-10-28T00:00:00Z"
  },
  "visual": {
    "icon": "https://cdn.jsdelivr.net/gh/Pyzyi/Netward@main/web/public/icon-512.png",
    "thumbnail": "",
    "screenshots": [
      "https://cdn.jsdelivr.net/gh/Pyzyi/Netward@main/deploy/casaos/Netward/screenshot-1.png",
      "https://cdn.jsdelivr.net/gh/Pyzyi/Netward@main/deploy/casaos/Netward/screenshot-2.png",
      "https://cdn.jsdelivr.net/gh/Pyzyi/Netward@main/deploy/casaos/Netward/screenshot-3.png",
      "https://cdn.jsdelivr.net/gh/Pyzyi/Netward@main/deploy/casaos/Netward/screenshot-4.png"
    ],
