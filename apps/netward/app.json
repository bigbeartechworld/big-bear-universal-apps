  },
  "resources": {
    "youtube": "",
    "documentation": "https://github.com/Pyzyi/Netward#readme",
    "repository": "https://github.com/Pyzyi/Netward",
    "issues": "https://github.com/Pyzyi/Netward/issues",
    "support": "https://community.bigbeartechworld.com/"
  },
  "technical": {
    "architectures": [
      "amd64",
      "arm64"
    ],
    "platform": "linux",
    "main_service": "app",
    "default_port": "8840",
    "main_image": "ghcr.io/pyzyi/netward",
    "compose_file": "docker-compose.yml"
  },
  "deployment": {
    "environment_variables": [
      {
        "name": "TZ",
        "default": "UTC",
        "description": "Time zone, e.g. Europe/Berlin",
        "required": false
      },
      {
        "name": "NETWARD_PORT",
        "default": "8840",
        "description": "Port of the web interface (host network)",
        "required": false
      }
    ],
    "volumes": [
      {
        "container": "/data",
        "description": "Database and backups"
      }
    ],
    "ports": []
  },
  "ui": {
    "scheme": "http",
    "path": "",
    "tips": {
      "before_install": {
        "en_us": "There is no default password. After installing, open Netward at http://your-server-ip:8840 **within 30 minutes** and create your account (only possible from your local network). If you miss that window, restart the app.\n\nNetward uses the host network so it can see every device. WatchYourLAN also uses port 8840 - if you run both, change NETWARD_PORT."
      }
    }
  },
  "compatibility": {
    "casaos": {
      "supported": true,
      "port_map": "8840",
      "port": "8840",
      "category": "Networking",
      "volume_mappings": {
        "netward_data": "/DATA/AppData/$AppID/data"
      }
    },
    "portainer": {
      "supported": true,
      "template_type": 2,
      "categories": [
        "Network",
        "selfhosted"
      ],
      "administrator_only": false,
      "port": "8840"
    },
    "runtipi": {
      "supported": false,
      "tipi_version": 1,
      "supported_architectures": [
        "amd64",
        "arm64"
      ],
      "port": "8840"
    },
    "dockge": {
      "supported": true,
      "file_based": true,
      "port": "8840"
    },
    "cosmos": {
      "supported": true,
      "servapp": true,
      "routes_required": true,
      "port": "8840"
    },
    "umbrel": {
      "supported": true,
      "manifest_version": 1,
      "volume_mappings": {
        "netward_data": "data"
      },
      "port": "8840"
    }
  },
  "tags": [
    "selfhosted",
    "docker",
    "bigbear",
    "network",
    "monitoring",
    "security",
    "lan",
    "device-discovery"
  ]
}
