{
  "spec_version": "1.0",
  "metadata": {
    "id": "cloudreve",
    "name": "Cloudreve",
    "description": "Cloudreve 4.19.1 is a self-hosted file manager with multi-cloud storage, backed by Postgres and Redis.",
    "version": "4.19.1",
    "author": "BigBearTechWorld",
    "developer": "Cloudreve",
    "category": "BigBearCasaOS",
    "license": "GPL-3.0",
    "homepage": "https://cloudreve.org",
    "source": "big-bear-universal",
    "created": "2026-10-05T00:00:00Z",
    "updated": "2026-10-05T00:00:00Z"
  },
  "visual": {
    "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/cloudreve.png",
    "thumbnail": "",
    "screenshots": [],
    "logo": "https://cdn.jsdelivr.net/gh/selfhst/icons@main/png/cloudreve.png"
  },
  "resources": {
    "documentation": "https://docs.cloudreve.org/overview/deploy/docker-compose",
    "repository": "https://github.com/cloudreve/Cloudreve",
    "issues": "https://github.com/cloudreve/Cloudreve/issues",
    "support": "https://community.bigbeartechworld.com/"
  },
  "technical": {
    "architectures": [
      "amd64",
      "arm64"
    ],
    "platform": "linux",
    "main_service": "cloudreve",
    "default_port": "5212",
    "main_image": "cloudreve/cloudreve",
    "compose_file": "docker-compose.yml"
  },
  "deployment": {
    "environment_variables": [
      {
        "name": "CR_CONF_Database.Type",
        "default": "postgres",
        "description": "Database driver.",
        "required": false
      },
      {
        "name": "CR_CONF_Database.Host",
        "default": "postgresql",
        "description": "Postgres service hostname.",
        "required": false
      },
      {
        "name": "CR_CONF_Database.User",
        "default": "cloudreve",
        "description": "Postgres user. Matches POSTGRES_USER.",
        "required": false
      },
      {
        "name": "CR_CONF_Database.Name",
        "default": "cloudreve",
        "description": "Postgres database name. Matches POSTGRES_DB.",
        "required": false
      },
      {
        "name": "CR_CONF_Database.Port",
        "default": "5432",
        "description": "Postgres port inside the Compose network.",
        "required": false
      },
      {
        "name": "CR_CONF_Redis.Server",
        "default": "redis:6379",
        "description": "Redis address on the Compose network.",
        "required": false
      },
      {
        "name": "POSTGRES_USER",
        "default": "cloudreve",
        "description": "Postgres role created on first start.",
        "required": false
      },
      {
        "name": "POSTGRES_DB",
        "default": "cloudreve",
        "description": "Postgres database created on first start.",
        "required": false
      },
      {
        "name": "POSTGRES_HOST_AUTH_METHOD",
        "default": "trust",
        "description": "Auth method from the official Compose file. Connections on the Compose network do not use a password.",
        "required": false
      }
    ],
    "volumes": [
      {
        "container": "/cloudreve/data",
        "description": "Cloudreve configuration and local storage"
      },
      {
        "container": "/var/lib/postgresql/data",
        "description": "Postgres data"
      },
      {
        "container": "/data",
        "description": "Redis data"
      }
    ],
    "ports": [
      {
        "container": "5212",
        "host": "5212",
        "protocol": "tcp",
        "description": "Cloudreve web UI"
      }
    ]
  },
  "ui": {
    "scheme": "http",
    "path": "",
    "tips": {
      "before_install": {
        "en_us": "Open http://localhost:5212 and register an account. The first account becomes the administrator. Postgres uses trust authentication on the internal network, matching the official Compose file."
      }
    }
  },
  "compatibility": {
    "casaos": {
      "supported": true,
      "port_map": "5212",
      "category": "Others",
      "volume_mappings": {
        "cloudreve_data": "/DATA/AppData/$AppID/data",
        "cloudreve_postgres": "/DATA/AppData/$AppID/postgres",
        "cloudreve_redis": "/DATA/AppData/$AppID/redis"
      }
    },
    "portainer": {
      "supported": true,
      "template_type": 2,
      "categories": [
        "BigBearCasaOS",
        "selfhosted"
      ],
      "administrator_only": false
    },
    "runtipi": {
      "supported": true,
      "tipi_version": 1,
      "supported_architectures": [
        "amd64",
        "arm64"
      ],
      "volume_mappings": {
        "cloudreve_data": "data",
        "cloudreve_postgres": "postgres",
        "cloudreve_redis": "redis"
      }
    },
    "dockge": {
      "supported": true,
      "file_based": true
    },
    "cosmos": {
      "supported": true,
      "servapp": true,
      "routes_required": true
    },
    "umbrel": {
      "supported": true,
      "manifest_version": 1,
      "volume_mappings": {
        "cloudreve_data": "data",
        "cloudreve_postgres": "postgres",
        "cloudreve_redis": "redis"
      }
    }
  },
  "tags": [
    "selfhosted",
    "docker",
    "bigbear",
    "bigbearcasaos",
    "files",
    "storage"
  ]
}
