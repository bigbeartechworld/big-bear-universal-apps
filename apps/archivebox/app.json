  "technical": {
    "architectures": [
      "amd64",
      "armv7",
      "arm64"
    ],
    "platform": "linux",
    "main_service": "app",
    "default_port": "8002",
    "main_image": "archivebox/archivebox",
    "compose_file": "docker-compose.yml"
  },
  "deployment": {
    "environment_variables": [
      {
        "name": "ALLOWED_HOSTS",
        "default": "*",
        "description": "Container Variable: ALLOWED_HOSTS",
        "required": false
      },
      {
        "name": "MEDIA_MAX_SIZE",
        "default": "500m",
        "description": "Container Variable: MEDIA_MAX_SIZE",
        "required": false
      },
      {
        "name": "PUBLIC_INDEX",
        "default": "true",
        "description": "Container Variable: PUBLIC_INDEX",
        "required": false
      },
      {
        "name": "PUBLIC_SNAPSHOTS",
        "default": "true",
        "description": "Container Variable: PUBLIC_SNAPSHOTS",
        "required": false
      },
      {
        "name": "PUBLIC_ADD_VIEW",
        "default": "true",
        "description": "Container Variable: PUBLIC_ADD_VIEW",
        "required": false
      }
    ],
    "volumes": [
      {
        "container": "/data",
        "description": "Container Path: /data"
      }
    ],
    "ports": [
      {
        "container": "8000",
        "host": "8002",
        "protocol": "tcp",
        "description": "Container Port: 8000"
      }
    ]
  },
  "ui": {
    "scheme": "http",
    "path": "",
    "tips": {}
  },
