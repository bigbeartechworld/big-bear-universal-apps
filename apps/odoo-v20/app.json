  "deployment": {
    "environment_variables": [
      {
        "name": "HOST",
        "default": "",
        "description": "Container Host: big-bear-odoo-v20-db",
        "required": false
      },
      {
        "name": "USER",
        "default": "",
        "description": "Container User: odoo",
        "required": false
      },
      {
        "name": "PASSWORD",
        "default": "",
        "description": "Container Password: c9983a93-bf4f-491a-bfef-c42eca42f04d",
        "required": false
      }
    ],
    "volumes": [
      {
        "container": "/etc/odoo",
        "description": "Container Path: /etc/odoo"
      },
      {
        "container": "/mnt/extra-addons",
        "description": "Container Path: /mnt/extra-addons"
      },
      {
        "container": "/var/lib/odoo",
        "description": "Container Path: /var/lib/odoo"
      }
    ],
    "ports": [
      {
        "container": "8069",
        "host": "8070",
        "protocol": "tcp",
        "description": "Container Port: 8069 (host port 8070 to avoid conflict with Odoo 19)"
      }
    ]
  },
  "ui": {
    "scheme": "http",
    "path": "",
    "tips": {
      "before_install": {
        "en_us": "NEW APP - ODOO V20\n\nThis is a NEW app, separate from 'odoo' (Odoo 19 on PostgreSQL 15). Both can run at the same time.\n\nFOR NEW USERS:\n- Install this app for new Odoo 20 deployments\n- Bundles PostgreSQL 16, which Odoo 20 requires\n- Web UI is on host port 8070\n\nFOR ODOO 19 USERS:\n- Do NOT uninstall your existing 'odoo' app\n- Do NOT point this app at the Odoo 19 database\n- Major upgrades need Odoo's upgrade service; swapping the image will not migrate the database\n- The PostgreSQL 15 data directory cannot be reused with PostgreSQL 16\n\nUpgrade guide: https://www.odoo.com/documentation/master/administration/upgrade.html"
      }
    }
  },
