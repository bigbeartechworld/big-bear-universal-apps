        "default": "redis",
        "description": "Container Variable: CACHE_TYPE",
        "required": false
      },
      {
        "name": "REDIS_URL",
        "default": "redis://redis:6379/",
        "description": "Container Variable: REDIS_URL",
        "required": false
      },
      {
        "name": "PUPPETEER_WS_ENDPOINT",
        "default": "ws://browserless:3000",
        "description": "Container Variable: PUPPETEER_WS_ENDPOINT",
        "required": false
      }
    ],
    "volumes": [
