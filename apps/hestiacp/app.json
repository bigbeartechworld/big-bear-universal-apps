  },
  "deployment": {
    "environment_variables": [
      {
        "name": "TZ",
        "default": "$TZ",
        "description": "Container Variable: TZ",
        "required": false
      }
    ],
    "volumes": [
      {
        "container": "/hestia",
        "description": "Container Path: /hestia"
      },
      {
        "container": "/home",
        "description": "Container Path: /home"
      },
      {
        "container": "/backup",
        "description": "Container Path: /backup"
      }
    ],
    "ports": [
      {
        "container": "8083",
        "host": "48112",
        "protocol": "tcp",
        "description": "Container Port: 8083"
      }
    ]
  },
  "ui": {
    "scheme": "http",
    "path": "",
    "tips": {
      "before_install": {
        "en_us": "Default `username` is `admin` and the default password can be found inside the `/DATA/AppData/hestiacp/config/root/password.txt` file."
      }
    }
  },
