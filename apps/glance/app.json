{
  "spec_version": "1.0",
  "metadata": {
    "id": "glance",
    "name": "Glance",
    "description": "Glance is a self-hosted dashboard that puts all your feeds in one place.",
    "tagline": "Self-hosted dashboard for your feeds",
    "version": "v0.8.5",
    "author": "BigBearTechWorld",
    "developer": "glanceapp",
    "category": "BigBearCasaOS",
    "license": "AGPL-3.0",
    "homepage": "https://github.com/glanceapp/glance",
    "source": "big-bear-universal",
    "created": "2026-08-13T20:45:00Z",
    "updated": "2026-08-13T20:45:00Z"
  },
  "visual": {
    "icon": "https://cdn.jsdelivr.net/gh/bigbeartechworld/big-bear-universal-apps/apps/glance/logo.png",
    "thumbnail": "",
    "screenshots": [],
    "logo": "https://cdn.jsdelivr.net/gh/bigbeartechworld/big-bear-universal-apps/apps/glance/logo.png"
  },
  "resources": {
    "youtube": "",
    "documentation": "https://github.com/glanceapp/glance/blob/main/docs/configuration.md",
    "repository": "https://github.com/glanceapp/glance",
    "issues": "https://github.com/glanceapp/glance/issues",
    "support": "https://community.bigbeartechworld.com/"
  },
  "technical": {
    "architectures": [
      "amd64",
      "arm64"
    ],
    "platform": "linux",
    "main_service": "app",
    "default_port": "8280",
    "main_image": "glanceapp/glance",
    "compose_file": "docker-compose.yml"
  },
  "deployment": {
    "environment_variables": [],
    "volumes": [
      {
        "container": "/app/config",
        "description": "Dashboard configuration, seeded with a starter glance.yml on first run"
      },
      {
        "container": "/var/run/docker.sock",
        "description": "Docker socket for the docker-containers widget (ro mount; still grants full Docker API access)"
      }
    ],
    "ports": [
      {
        "container": "8080",
        "host": "8280",
        "protocol": "tcp",
        "description": "Web UI"
      }
    ]
  },
  "ui": {
    "scheme": "http",
    "path": "",
    "tips": {
      "before_install": {
        "en_us": "A starter glance.yml is created on first run. Edit it to customize your dashboard; if it is ever left invalid or half-written, delete it and restart to get a fresh starter config. The Docker socket is mounted for the containers widget - this grants Glance root-equivalent access to Docker regardless of the read-only flag, so delete the docker-containers widget from glance.yml after install, or remove the socket volume from the compose file before deploying, if you do not want the widget."
      }
    }
  },
  "compatibility": {
    "casaos": {
      "supported": true,
      "port_map": "8280",
      "port": "8280",
      "category": "Others",
      "volume_mappings": {
        "glance_config": "/DATA/AppData/$AppID/config"
      }
    },
    "portainer": {
      "supported": true,
      "template_type": 2,
      "categories": [
        "BigBearCasaOS",
        "selfhosted"
      ],
      "administrator_only": false,
      "port": "8280"
    },
    "runtipi": {
      "supported": false,
      "tipi_version": 1,
      "supported_architectures": [
        "amd64",
        "arm64"
      ],
      "port": "8280",
      "volume_mappings": {
        "glance_config": "config"
      }
    },
    "dockge": {
      "supported": true,
      "file_based": true,
      "port": "8280"
    },
    "cosmos": {
      "supported": true,
      "servapp": true,
      "routes_required": true,
      "port": "8280"
    },
    "umbrel": {
      "supported": true,
      "manifest_version": 1,
      "port": "10202",
      "app_port": "8080",
      "volume_mappings": {
        "glance_config": "config"
      }
    }
  },
  "tags": [
    "selfhosted",
    "docker",
    "bigbear",
    "bigbearcasaos",
    "dashboard",
    "rss",
    "feeds"
  ]
}
