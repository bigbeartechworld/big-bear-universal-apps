  "deployment": {
    "environment_variables": [
      {
        "name": "JOOMLA_DB_HOST",
        "default": "joomladb",
        "description": "Container Variable: JOOMLA_DB_HOST",
        "required": false
      },
      {
        "name": "JOOMLA_DB_PASSWORD",
        "default": "15311349-803b-40a2-9153-5b13f8d4022e",
        "description": "Container Variable: JOOMLA_DB_PASSWORD",
        "required": false
      },
      {
        "name": "MYSQL_ROOT_PASSWORD",
        "default": "15311349-803b-40a2-9153-5b13f8d4022e",
        "description": "Container Variable: MYSQL_ROOT_PASSWORD",
        "required": false
      }
    ],
    "volumes": [
      {
        "container": "/var/www/html",
        "description": "Container Path: /var/www/html"
      },
      {
        "container": "/var/lib/mysql",
        "description": "Container Path: /var/lib/mysql"
      }
    ],
    "ports": [
      {
        "container": "80",
        "host": "80",
        "protocol": "tcp",
        "description": "Container Port: 80"
      }
    ]
  },
