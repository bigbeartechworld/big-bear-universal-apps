  "technical": {
    "architectures": [
      "amd64",
      "arm64"
    ],
    "platform": "linux",
    "main_service": "app",
    "default_port": "4000",
    "main_image": "ghcr.io/fclairamb/solidping",
    "compose_file": "docker-compose.yml"
  },
  "deployment": {
    "environment_variables": [],
    "volumes": [
      {
        "container": "/data",
        "description": "SQLite database and uploaded files."
      }
    ],
    "ports": [
      {
        "container": "4000",
        "host": "4000",
        "protocol": "tcp",
        "description": "Web UI and API"
      }
    ]
  },
  "ui": {
    "scheme": "http",
    "path": "",
    "tips": {
      "before_install": {
        "en_us": "First login: admin@solidping.io / solidpass, organization \"default\". You are asked to set a new password immediately."
      }
    }
  },
  "compatibility": {
    "casaos": {
      "supported": true,
      "port_map": "4000",
      "port": "4000",
      "category": "Networking",
      "volume_mappings": {
        "solidping_data": "/DATA/AppData/$AppID/data"
      }
    },
    "portainer": {
      "supported": true,
      "template_type": 2,
      "categories": [
        "Monitoring",
        "selfhosted"
      ],
      "administrator_only": false,
      "port": "4000"
    },
    "runtipi": {
      "supported": true,
      "tipi_version": 1,
      "supported_architectures": [
        "amd64",
        "arm64"
      ],
      "port": "4000",
      "volume_mappings": {
        "solidping_data": "data"
      }
    },
    "dockge": {
      "supported": true,
      "file_based": true,
      "port": "4000"
    },
    "cosmos": {
      "supported": true,
      "servapp": true,
      "routes_required": true,
      "port": "4000"
    },
    "umbrel": {
      "supported": true,
      "manifest_version": 1,
      "port": "10400",
      "app_port": "4000",
      "volume_mappings": {
        "solidping_data": "data"
      }
    }
  },
